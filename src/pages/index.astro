---
import Layout from '../layouts/Layout.astro';
import type { ImageMetadata } from 'astro';

// 自动获取 src/images/ 目录下的所有图片（Astro 5 推荐用法，替代已弃用的 Astro.glob）
const modules = import.meta.glob<{ default: ImageMetadata }>(
	'../images/*.{jpeg,jpg,png,gif,webp,avif}',
	{ eager: true }
);

// 按文件名排序，得到 { name, image } 列表
const images = Object.entries(modules)
	.map(([path, mod]) => ({
		name: path.split('/').pop() ?? path,
		image: mod.default,
	}))
	.sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="我的图片分享空间">
	<main>
		<h1>📸 我的图片分享</h1>
		<p class="description">
			把图片放入 <code>src/images/</code> 目录，即可自动同步到这里。
		</p>

		{
			images.length === 0 ? (
				<p class="empty">
					还没有图片。请往 <code>src/images/</code> 里丢几张图片试试。
				</p>
			) : (
				<div class="image-grid">
					{images.map(({ name, image }) => (
						<div class="image-card">
							<img
								src={image.src}
								alt={name}
								width={image.width}
								height={image.height}
								loading="lazy"
							/>
							<div class="image-info">
								<span>{name}</span>
							</div>
						</div>
					))}
				</div>
			)
		}
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 2rem;
		max-width: 1200px;
	}
	h1 {
		text-align: center;
		color: #333;
	}
	.description {
		text-align: center;
		color: #666;
	}
	.empty {
		text-align: center;
		color: #999;
		margin-top: 3rem;
	}
	.image-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 20px;
		margin-top: 2rem;
	}
	.image-card {
		border: 1px solid #eee;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
		transition: transform 0.2s;
		background: #fff;
	}
	.image-card:hover {
		transform: translateY(-5px);
	}
	.image-card :global(img) {
		width: 100%;
		height: 250px;
		object-fit: cover;
		display: block;
	}
	.image-info {
		padding: 10px;
		font-size: 0.85rem;
		color: #555;
		text-align: center;
	}
</style>
